---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	CONTACT_PHONE,
	CONTACT_PHONE_HREF,
	CONTACT_EMAIL,
} from '../consts';

const highlights = [
	'Expert Guidance',
	'Personalized Solutions',
	'Proactive Approach',
	'Exceptional Customer Service',
];

const values = [
	{
		title: 'Upholding Ethical Standards',
		description:
			'We adhere to the highest ethical standards, ensuring honesty and fairness in every interaction.',
	},
	{
		title: 'Ensuring Precise Accuracy',
		description:
			'Our commitment to precision guarantees that every tax filing and business service is meticulously executed.',
	},
	{
		title: 'Delivering Professional Excellence',
		description:
			'We set a standard of excellence that builds trust and instills confidence in our clients.',
	},
];

const services = [
	{
		title: 'Virtual & Mobile Tax Return Preparation',
		description:
			'Whether you’re an individual taxpayer or a business owner, our experienced team offers convenient virtual and mobile tax preparation services tailored to your needs.',
	},
	{
		title: 'Business Formation Services',
		description:
			'From consultation to EIN assistance and virtual address setup, we provide comprehensive support to help your business get off the ground with confidence.',
	},
	{
		title: 'Mobile Notary Services',
		description:
			'Serving the Dallas–Fort Worth area, our mobile notary services ensure your important documents are properly authenticated when and where you need them.',
	},
];

const resources = [
	{
		question: 'Where can I get the status of my refund?',
		answer:
			'You can check the status of your federal refund directly with the IRS using the Where’s My Refund tool.',
		linkLabel: 'Check your refund status',
		href: 'https://www.irs.gov/refunds',
	},
	{
		question: 'What business expenses can I deduct?',
		answer:
			'The IRS provides guidance on which business expenses are deductible and how to claim them.',
		linkLabel: 'IRS guide to deducting business expenses',
		href: 'https://www.irs.gov/businesses/small-businesses-self-employed/deducting-business-expenses',
	},
	{
		question: 'Where can I get help filling out my W-4?',
		answer:
			'The IRS offers instructions and a withholding estimator to help you complete Form W-4 accurately.',
		linkLabel: 'About Form W-4',
		href: 'https://www.irs.gov/forms-pubs/about-form-w-4',
	},
	{
		question: 'More IRS resources',
		answer:
			'Forms, publications, payment options, and more are available on the official IRS website.',
		linkLabel: 'Visit IRS.gov',
		href: 'https://www.irs.gov',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="container hero-grid">
					<div>
						<p class="eyebrow">EB Tax Solutions</p>
						<h1>
							Your trusted partner for<br />
							<em>expert tax services.</em>
						</h1>
						<p class="lede">
							Enjoy expert tax services in all 50 US states, personalized just
							for you.
						</p>
						<div class="hero-actions">
							<a class="btn btn-light" href="/contact">Get started</a>
							<a class="btn btn-ghost" href="#services">Our services</a>
						</div>
						<ul class="hero-points">
							{highlights.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div class="hero-photo">
						<img
							src="/images/evin-hero.jpg"
							alt="Evin Basher, founder of EB Tax Solutions"
							width="1200"
							height="1800"
						/>
					</div>
				</div>
			</section>

			<!-- Welcome -->
			<section class="welcome" id="welcome">
				<div class="container welcome-grid">
					<div>
						<p class="eyebrow dark">Welcome to EB Tax Solutions</p>
						<h2>We will provide the best tax service for your business.</h2>
						<p>
							At EB Tax Solutions, we’re more than just a tax preparation
							firm. We’re dedicated to empowering individuals and businesses
							with the knowledge and tools they need to navigate the
							complexities of the tax landscape.
						</p>
						<p>
							Our founder, Evin Basher, started this journey driven by a
							personal experience, determined to bring professionalism and
							education back into the tax industry.
						</p>
						<p class="signature">
							Evin Basher
							<span>Founder, EB Tax Solutions</span>
						</p>
					</div>
					<aside class="welcome-card">
						<p class="card-label">Contact us today</p>
						<p class="card-title">Our team will reach out to you.</p>
						<p class="card-copy">
							Tell us a little about your situation and we’ll follow up with
							exactly how we can help.
						</p>
						<a class="btn btn-dark" href="/contact">Contact us</a>
					</aside>
				</div>
			</section>

			<!-- Values -->
			<section class="values-band">
				<div class="container">
					<div class="value-grid">
						{
							values.map((value) => (
								<article class="value-card">
									<h3>{value.title}</h3>
									<p>{value.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- Services -->
			<section class="services" id="services">
				<div class="container">
					<p class="eyebrow dark">Our services</p>
					<h2>Expert solutions offered</h2>
					<p class="section-lede">
						Explore our range of tax preparation and business services
						designed to streamline your financial practices and maximize your
						returns.
					</p>
					<div class="service-grid">
						{
							services.map((service, i) => (
								<article class="service-card">
									<span class="service-index">
										{String(i + 1).padStart(2, '0')}
									</span>
									<h3>{service.title}</h3>
									<p>{service.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- Meet Evin -->
			<section class="about" id="about">
				<div class="container about-grid">
					<figure class="about-photo">
						<img
							src="/images/evin-portrait.jpg"
							alt="Evin Basher, founder of EB Tax Solutions"
							width="1200"
							height="1800"
						/>
						<figcaption>
							<span class="name">Evin Basher</span>
							<span class="role">Founder, EB Tax Solutions</span>
						</figcaption>
					</figure>
					<div>
						<p class="eyebrow dark">Your tax expert</p>
						<h2>Meet Evin Basher: your tax advocate</h2>
						<p>
							Evin Basher, the founder of EB Tax Solutions, brings a passion
							for education and professionalism to the tax services industry.
							His commitment to integrity and accuracy is at the core of the
							firm’s mission to empower and educate its clients.
						</p>
						<p>
							Under Evin’s leadership, EB Tax Solutions stands out as a beacon
							of knowledge and reliability, helping clients navigate the
							complexities of tax preparation and business planning with ease
							and confidence.
						</p>
						<a class="btn btn-dark" href="/about">Learn more</a>
					</div>
				</div>
			</section>

			<!-- Testimonial -->
			<section class="testimonial">
				<div class="container testimonial-grid">
					<div>
						<p class="eyebrow">Testimonials</p>
						<h2>What our clients say</h2>
						<p class="testimonial-copy">
							Our clients appreciate our dedication to professionalism, deep
							expertise, and genuine care for their unique tax needs. We take
							great pride in guiding each client to maximize their financial
							outcomes and ensuring they benefit from every possible advantage
							in their tax situations.
						</p>
					</div>
					<figure class="quote-card">
						<blockquote>
							“It’s my first year using EB Tax Solutions and I have to say I
							am very impressed and satisfied with my service. Evin was very
							professional and made sure I received every tax deduction I
							deserved. Also the process and application was easy to
							understand; communication was 10/10 and very flexible
							appointment times. I highly recommend them for your tax needs. I
							will definitely use their services in the future!”
						</blockquote>
						<figcaption>Brandy Gross</figcaption>
					</figure>
				</div>
			</section>

			<!-- Resources -->
			<section class="resources" id="resources">
				<div class="container">
					<p class="eyebrow dark">Resources</p>
					<h2>Useful links &amp; information</h2>
					<div class="accordion">
						{
							resources.map((item) => (
								<details>
									<summary>{item.question}</summary>
									<div class="accordion-body">
										<p>{item.answer}</p>
										<a href={item.href} target="_blank" rel="noopener">
											{item.linkLabel}
										</a>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</section>

			<!-- Contact / CTA -->
			<section class="contact" id="contact">
				<div class="container">
					<h2>Ready to take control of your taxes and financial future?</h2>
					<p class="contact-lede">
						Contact EB Tax Solutions today to schedule your consultation and
						experience the difference expertise and dedication can make.
					</p>
					<div class="contact-actions">
						<a class="btn btn-light" href="/contact">Get started</a>
						<a class="btn btn-ghost" href={CONTACT_PHONE_HREF}>
							Call {CONTACT_PHONE}
						</a>
						<a class="btn btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>
							{CONTACT_EMAIL}
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.container {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	section {
		padding: 6rem 0;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 1rem;
	}
	.eyebrow {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #9a9da3;
		margin: 0 0 1.25rem;
	}
	.eyebrow.dark {
		color: var(--color-muted);
	}
	.section-lede {
		max-width: 38rem;
		font-size: 1.1rem;
		color: var(--color-muted);
		margin: 0 0 3rem;
	}

	/* Buttons */
	.btn {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.btn-light {
		background: #fff;
		color: var(--color-ink);
	}
	.btn-light:hover {
		background: #d9dadd;
		color: var(--color-ink);
	}
	.btn-ghost {
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.4);
	}
	.btn-ghost:hover {
		color: #fff;
		border-color: #fff;
	}
	.btn-dark {
		background: var(--color-ink);
		color: #fff;
	}
	.btn-dark:hover {
		background: #2a2b2e;
		color: #fff;
	}

	/* Hero */
	.hero {
		background: var(--color-ink);
		color: #c7c9cc;
		padding: 6rem 0;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
	}
	.hero-photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
		border: 1px solid rgba(255, 255, 255, 0.12);
	}
	.hero h1 {
		font-size: clamp(2.75rem, 6.5vw, 4.5rem);
		color: #fff;
		margin-bottom: 1.5rem;
	}
	.hero h1 em {
		color: #9a9da3;
	}
	.lede {
		max-width: 36rem;
		font-size: 1.2rem;
		margin: 0 0 2.5rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 3.5rem;
	}
	.hero-points {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		list-style: none;
		margin: 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		font-size: 0.95rem;
		font-weight: 500;
	}
	.hero-points li::before {
		content: '—';
		margin-right: 0.6rem;
		color: #6e7278;
	}

	/* Welcome */
	.welcome-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 4rem;
		align-items: start;
	}
	.welcome p {
		font-size: 1.05rem;
	}
	.signature {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--color-ink);
		margin-top: 2rem;
	}
	.signature span {
		display: block;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-muted);
		margin-top: 0.25rem;
	}
	.welcome-card {
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: 16px;
		padding: 2.5rem;
		position: sticky;
		top: 6rem;
	}
	.card-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-muted);
		margin: 0 0 0.75rem;
	}
	.card-title {
		font-family: var(--font-display);
		font-size: 1.6rem;
		color: var(--color-ink);
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}
	.card-copy {
		font-size: 0.98rem;
		color: var(--color-muted);
		margin: 0 0 1.5rem;
	}

	/* Values */
	.values-band {
		background: var(--color-ink);
		padding: 4.5rem 0;
	}
	.value-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.value-card {
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 12px;
		padding: 2rem;
	}
	.value-card h3 {
		font-size: 1.35rem;
		color: #fff;
		margin-bottom: 0.75rem;
	}
	.value-card p {
		font-size: 0.98rem;
		color: #b9bbbf;
		margin: 0;
	}

	/* Services */
	.services {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-line);
	}
	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.service-card {
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: 12px;
		padding: 2rem;
		transition: border-color 0.15s ease;
	}
	.service-card:hover {
		border-color: var(--color-ink);
	}
	.service-index {
		display: block;
		font-family: var(--font-display);
		font-size: 1.1rem;
		color: #9a9da3;
		margin-bottom: 1.25rem;
	}
	.service-card h3 {
		font-size: 1.35rem;
		margin-bottom: 0.75rem;
	}
	.service-card p {
		font-size: 0.98rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* About */
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 4rem;
		align-items: center;
	}
	.about-photo {
		margin: 0;
		position: relative;
	}
	.about-photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
	}
	.about-photo figcaption {
		position: absolute;
		left: 1.5rem;
		bottom: 1.5rem;
		background: #fff;
		border-radius: 10px;
		padding: 0.75rem 1.25rem;
		box-shadow: var(--box-shadow);
		display: flex;
		flex-direction: column;
	}
	.about-photo .name {
		font-family: var(--font-display);
		font-size: 1.1rem;
		color: var(--color-ink);
	}
	.about-photo .role {
		font-size: 0.85rem;
		color: var(--color-muted);
	}
	.about p {
		font-size: 1.05rem;
	}
	.about .btn {
		margin-top: 0.75rem;
	}

	/* Testimonial */
	.testimonial {
		background: var(--color-ink);
		color: #c7c9cc;
	}
	.testimonial h2 {
		color: #fff;
	}
	.testimonial-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: 4rem;
		align-items: center;
	}
	.testimonial-copy {
		font-size: 1.05rem;
		margin: 0;
	}
	.quote-card {
		background: #fff;
		border-radius: 16px;
		padding: 2.5rem;
		margin: 0;
	}
	.quote-card blockquote {
		border: none;
		padding: 0;
		margin: 0 0 1.5rem;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--color-body);
	}
	.quote-card figcaption {
		font-family: var(--font-display);
		font-size: 1.2rem;
		color: var(--color-ink);
	}

	/* Resources */
	.accordion {
		max-width: 46rem;
		margin-top: 2rem;
	}
	.accordion details {
		border: 1px solid var(--color-line);
		border-radius: 10px;
		margin-bottom: 0.75rem;
		background: var(--color-surface);
	}
	.accordion summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--color-ink);
		padding: 1.1rem 1.4rem;
		list-style-position: inside;
	}
	.accordion-body {
		padding: 0 1.4rem 1.25rem;
	}
	.accordion-body p {
		margin: 0 0 0.5rem;
		font-size: 0.98rem;
		color: var(--color-muted);
	}
	.accordion-body a {
		font-weight: 500;
	}

	/* Contact */
	.contact {
		background: var(--color-ink);
		color: #c7c9cc;
		text-align: center;
		padding: 7rem 0;
	}
	.contact h2 {
		color: #fff;
		max-width: 40rem;
		margin-left: auto;
		margin-right: auto;
	}
	.contact-lede {
		max-width: 34rem;
		margin: 0 auto 2.5rem;
		font-size: 1.1rem;
	}
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.service-grid,
		.value-grid {
			grid-template-columns: 1fr;
		}
		.welcome-grid,
		.about-grid,
		.testimonial-grid,
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.welcome-card {
			position: static;
		}
		.hero-photo {
			max-width: 20rem;
		}
		.about-photo {
			max-width: 20rem;
		}
	}
	@media (max-width: 720px) {
		section {
			padding: 4rem 0;
		}
		.hero {
			padding: 4rem 0;
		}
	}
</style>
