---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, QUOTE_URL } from '../consts';

const values = [
	{
		title: 'Upholding Ethical Standards',
		description:
			'We adhere to the highest ethical standards, ensuring honesty and fairness in every interaction.',
	},
	{
		title: 'Ensuring Precise Accuracy',
		description:
			'Our commitment to precision guarantees that every tax filing and business service is meticulously executed.',
	},
	{
		title: 'Delivering Professional Excellence',
		description:
			'We set a standard of excellence that builds trust and instills confidence in our clients.',
	},
	{
		title: 'Empowering Through Education',
		description:
			'We’re dedicated to giving individuals and businesses the knowledge and tools they need to navigate the complexities of the tax landscape.',
	},
];

// This page is specifically about Evin, so it gets its own Person entity in
// addition to the sitewide AccountingService schema in BaseHead.
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Evin Basher',
	jobTitle: 'Founder',
	worksFor: {
		'@type': 'AccountingService',
		name: SITE_TITLE,
	},
	url: new URL('/about', Astro.site).toString(),
};
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<BaseHead
			title="Meet Evin Basher, Founder & Tax Advocate | EB Tax Solutions"
			description="Meet Evin Basher, founder of EB Tax Solutions. Learn about his mission to bring professionalism and education back to tax preparation for clients nationwide."
		/>
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(personSchema)}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<!-- Page header -->
			<section class="page-header">
				<div class="container">
					<p class="eyebrow">About EB Tax Solutions</p>
					<h1>The person behind <em>your return.</em></h1>
					<p class="lede">
						Taxes are personal. The person preparing them should be too.
					</p>
				</div>
			</section>

			<!-- Bio -->
			<section class="bio">
				<div class="container bio-grid">
					<img
						class="bio-photo reveal"
						src="/images/evin-standing.jpg"
						alt="Evin Basher, founder of EB Tax Solutions"
						width="1200"
						height="1800"
						loading="lazy"
					/>
					<div class="reveal reveal-2">
						<h2>Meet Evin Basher: your tax advocate</h2>
						<p>
							Evin Basher, the founder of EB Tax Solutions, brings a passion
							for education and professionalism to the tax services industry.
							His commitment to integrity and accuracy is at the core of the
							firm’s mission to empower and educate its clients.
						</p>
						<p>
							At EB Tax Solutions, we’re more than just a tax preparation
							firm. We’re dedicated to empowering individuals and businesses
							with the knowledge and tools they need to navigate the
							complexities of the tax landscape. Evin started this journey
							driven by a personal experience, determined to bring
							professionalism and education back into the tax industry.
						</p>
						<p>
							Under Evin’s leadership, EB Tax Solutions stands out as a beacon
							of knowledge and reliability, helping clients navigate the
							complexities of tax preparation and business planning with ease
							and confidence — with expert tax services available in all 50 US
							states, and mobile notary services in the Dallas–Fort Worth
							area.
						</p>
					</div>
				</div>
			</section>

			<!-- Values -->
			<section class="values">
				<div class="container">
					<p class="eyebrow dark">How Evin works</p>
					<h2>What you can expect</h2>
					<div class="value-grid">
						{
							values.map((value, i) => (
								<article class={`value-card reveal reveal-${i + 1}`}>
									<h3>{value.title}</h3>
									<p>{value.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-band">
				<div class="container reveal">
					<h2>Ready to take control of your taxes and financial future?</h2>
					<p class="cta-lede">
						Contact EB Tax Solutions today to schedule your consultation and
						experience the difference expertise and dedication can make.
					</p>
					<a
						class="btn btn-light"
						href={QUOTE_URL}
						target="_blank"
						rel="noopener"
					>
						Free Tax Quote
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.container {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	section {
		padding: 6rem 0;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 1rem;
	}
	.eyebrow {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #9a9da3;
		margin: 0 0 1.25rem;
	}
	.eyebrow.dark {
		color: var(--color-muted);
	}
	.btn {
		display: inline-block;
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.btn-light {
		background: #fff;
		color: var(--color-ink);
	}
	.btn-light:hover {
		background: #d9dadd;
		color: var(--color-ink);
	}

	/* Page header */
	.page-header {
		background: var(--color-ink);
		color: #c7c9cc;
		padding: 6rem 0;
	}
	.page-header h1 {
		font-size: clamp(2.5rem, 5.5vw, 4rem);
		color: #fff;
		margin-bottom: 1rem;
	}
	.page-header h1 em {
		color: #9a9da3;
	}
	.lede {
		max-width: 36rem;
		font-size: 1.2rem;
		margin: 0;
	}

	/* Bio */
	.bio-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
		gap: 4rem;
		align-items: start;
	}
	.bio-photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
		position: sticky;
		top: 6rem;
	}
	.bio p {
		font-size: 1.05rem;
	}

	/* Values */
	.values {
		background: var(--color-surface);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}
	.value-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-top: 2.5rem;
	}
	.value-card {
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: 12px;
		padding: 2rem;
	}
	.value-card h3 {
		font-size: 1.35rem;
		margin-bottom: 0.75rem;
	}
	.value-card p {
		font-size: 0.98rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* CTA band */
	.cta-band {
		background: var(--color-ink);
		color: #c7c9cc;
		text-align: center;
	}
	.cta-band h2 {
		color: #fff;
	}
	.cta-lede {
		margin: 0 0 2rem;
		font-size: 1.1rem;
	}

	@media (max-width: 900px) {
		.bio-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.bio-photo {
			max-width: 20rem;
			position: static;
		}
	}
	@media (max-width: 720px) {
		section,
		.page-header,
		.cta-band {
			padding: 3.5rem 0;
		}
		.container {
			padding: 0 1.25rem;
		}
		.page-header h1 {
			font-size: 2.25rem;
		}
		h2 {
			font-size: 1.85rem;
		}
		.lede,
		.cta-lede {
			font-size: 1.05rem;
		}
		.bio-photo {
			max-width: 100%;
			aspect-ratio: 4 / 5;
			object-fit: cover;
			object-position: center 15%;
		}
		.value-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
			margin-top: 2rem;
		}
		.value-card {
			padding: 1.5rem;
		}
		.cta-band .btn {
			display: block;
			text-align: center;
		}
		/* Clear the sticky quote bar so the CTA isn't hidden behind it. */
		.cta-band {
			padding-bottom: 7rem;
		}
	}
	@media (max-width: 420px) {
		.page-header h1 {
			font-size: 2rem;
		}
		h2 {
			font-size: 1.65rem;
		}
	}
</style>
