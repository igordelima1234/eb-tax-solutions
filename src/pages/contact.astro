---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import {
	CONTACT_PHONE,
	CONTACT_PHONE_HREF,
	CONTACT_EMAIL,
	CONTACT_HOURS,
	QUOTE_URL,
	HUBSPOT_PORTAL_ID,
	HUBSPOT_FORM_ID,
	HUBSPOT_REGION,
} from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Contact Us for a Free Tax Quote | EB Tax Solutions"
			description="Contact EB Tax Solutions to schedule a free tax quote. Reach Evin Basher by phone, email, or online — serving clients nationwide and Dallas–Fort Worth."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<!-- Page header -->
			<section class="page-header">
				<div class="container">
					<p class="eyebrow">Contact</p>
					<h1>Let’s talk <em>taxes.</em></h1>
					<p class="lede">
						Contact EB Tax Solutions today to schedule your consultation and
						experience the difference expertise and dedication can make. Our
						team will reach out to you.
					</p>
				</div>
			</section>

			<!-- Contact info + form -->
			<section class="contact-body">
				<div class="container contact-grid">
					<div class="contact-info">
						<h2>Get in touch</h2>
						<p>
							Prefer to just pick up the phone or send an email? That works
							too.
						</p>
						<div class="info-item">
							<span class="info-icon"><Icon name="phone" size={20} /></span>
							<div>
								<p class="info-label">Phone</p>
								<a href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a>
							</div>
						</div>
						<div class="info-item">
							<span class="info-icon"><Icon name="mail" size={20} /></span>
							<div>
								<p class="info-label">Email</p>
								<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
							</div>
						</div>
						<div class="info-item">
							<span class="info-icon"><Icon name="clock" size={20} /></span>
							<div>
								<p class="info-label">Hours</p>
								<p class="info-value">{CONTACT_HOURS}</p>
							</div>
						</div>
						<div class="info-item">
							<span class="info-icon"><Icon name="map-pin" size={20} /></span>
							<div>
								<p class="info-label">Location</p>
								<p class="info-value">
									Serving all 50 US states virtually<br />
									Mobile notary in the Dallas–Fort Worth area
								</p>
							</div>
						</div>
					</div>

					<div class="contact-form">
						<!-- HubSpot injects the form here. The fallback below is the
							 container's initial content and gets cleared just before
							 injection, so it stays put if the embed script never loads. -->
						<div
							id="hubspot-form"
							data-portal-id={HUBSPOT_PORTAL_ID}
							data-form-id={HUBSPOT_FORM_ID}
							data-region={HUBSPOT_REGION}
						>
							<p class="form-fallback">
								Loading the form… If it doesn’t appear, reach us directly at
								<a href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a> or
								<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-band">
				<div class="container">
					<h2>Ready to take control of your taxes and financial future?</h2>
					<p class="cta-lede">
						Prefer to skip the form? Start your quote request directly and
						we’ll take it from there.
					</p>
					<a
						class="btn btn-light"
						href={QUOTE_URL}
						target="_blank"
						rel="noopener"
					>
						Claim Your Free Tax Quote
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const HUBSPOT_SRC = 'https://js-na2.hsforms.net/forms/embed/v2.js';

			function createHubspotForm(target: HTMLElement) {
				const hbspt = (window as any).hbspt;
				if (!hbspt) return;
				// Drop the fallback text, and any form left over from a previous
				// visit, so navigating back here never stacks two forms.
				target.innerHTML = '';
				hbspt.forms.create({
					portalId: target.dataset.portalId,
					formId: target.dataset.formId,
					region: target.dataset.region,
					// Without an explicit target HubSpot injects wherever the script
					// tag sits, which isn't stable across a view-transition DOM swap.
					target: '#hubspot-form',
				});
			}

			// Runs on first load and after every client-side navigation. The
			// listener lives on `document`, which survives page swaps, so the
			// body re-queries the fresh DOM each time.
			document.addEventListener('astro:page-load', () => {
				// Fires on every page, so bail when this isn't the contact page.
				const target = document.getElementById('hubspot-form');
				if (!target) return;

				// Already loaded from an earlier visit — just re-create the form.
				if ((window as any).hbspt) {
					createHubspotForm(target);
					return;
				}

				const onReady = () => createHubspotForm(target);
				const existing = document.querySelector(
					`script[src="${HUBSPOT_SRC}"]`,
				);
				if (existing) {
					// Injected but still in flight; wait for the same tag.
					existing.addEventListener('load', onReady);
					return;
				}

				const script = document.createElement('script');
				script.src = HUBSPOT_SRC;
				script.async = true;
				script.addEventListener('load', onReady);
				document.head.appendChild(script);
			});
		</script>
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.container {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.eyebrow {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #9a9da3;
		margin: 0 0 1.25rem;
	}

	/* Page header */
	.page-header {
		background: var(--color-ink);
		color: #c7c9cc;
		padding: 6rem 0;
	}
	.page-header h1 {
		font-size: clamp(2.5rem, 5.5vw, 4rem);
		color: #fff;
		margin-bottom: 1rem;
	}
	.page-header h1 em {
		color: #9a9da3;
	}
	.lede {
		max-width: 36rem;
		font-size: 1.2rem;
		margin: 0;
	}

	/* Layout */
	.contact-body {
		padding: 6rem 0;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 4rem;
		align-items: start;
	}

	/* Info column */
	.contact-info h2 {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		margin-bottom: 0.75rem;
	}
	.contact-info > p {
		color: var(--color-muted);
		margin-bottom: 2.5rem;
	}
	.info-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--color-line);
	}
	.info-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		color: var(--color-ink);
	}
	.info-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-muted);
		margin: 0 0 0.35rem;
	}
	.info-item a {
		font-size: 1.1rem;
		font-weight: 500;
		text-decoration: none;
	}
	.info-item a:hover {
		text-decoration: underline;
	}
	.info-value {
		margin: 0;
		font-size: 1rem;
	}

	/* Form card */
	.contact-form {
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: 16px;
		padding: 2.5rem;
	}
	.form-fallback {
		margin: 0;
		color: var(--color-muted);
	}

	/*
	  HubSpot injects its markup after render, so those elements never get
	  Astro's data-astro-cid-* attribute — scoped selectors can't reach them.
	  Everything below must stay wrapped in :global().
	*/
	.contact-form :global(.hs-form),
	.contact-form :global(.hs-form) :global(*) {
		font-family: var(--font-body);
	}
	.contact-form :global(.hs-form-field) {
		margin-bottom: 1.25rem;
	}
	.contact-form :global(.hs-form-field > label) {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-ink);
		margin-bottom: 0.4rem;
	}
	/* HubSpot's own helper text under a label. */
	.contact-form :global(.hs-field-desc) {
		font-size: 0.85rem;
		color: var(--color-muted);
		margin: 0 0 0.4rem;
	}
	.contact-form :global(.hs-input) {
		width: 100%;
		box-sizing: border-box;
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--color-ink);
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: 8px;
		padding: 0.7rem 0.9rem;
	}
	.contact-form :global(textarea.hs-input) {
		resize: vertical;
	}
	/* Checkbox and radio inputs must not stretch to full width. */
	.contact-form :global(.hs-input[type='checkbox']),
	.contact-form :global(.hs-input[type='radio']) {
		width: auto;
		margin-right: 0.5rem;
	}
	.contact-form :global(.hs-input:focus) {
		outline: 2px solid var(--color-ink);
		outline-offset: 1px;
		border-color: var(--color-ink);
	}
	.contact-form :global(.hs-button) {
		display: inline-block;
		box-sizing: border-box;
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
		color: #fff;
		background: var(--color-ink);
		border: none;
		cursor: pointer;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		transition: background 0.15s ease;
	}
	.contact-form :global(.hs-button:hover) {
		background: #2a2b2e;
	}
	/* Validation errors and the required asterisk. */
	.contact-form :global(.hs-error-msg),
	.contact-form :global(.hs-error-msgs) {
		font-size: 0.85rem;
		color: #b3261e;
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}
	.contact-form :global(.hs-form-required) {
		color: #b3261e;
	}
	/* Post-submit confirmation, styled like the old success box. */
	.contact-form :global(.submitted-message) {
		padding: 0.9rem 1.1rem;
		background: #fff;
		border: 1px solid var(--color-ink);
		border-radius: 8px;
		font-weight: 500;
		color: var(--color-ink);
	}
	.btn {
		display: inline-block;
		/* Anchors don't get border-box from the UA stylesheet the way form
		   controls do, so width:100% below would add the padding on top. */
		box-sizing: border-box;
		font-size: 1rem;
		font-weight: 700;
		border: none;
		cursor: pointer;
		text-decoration: none;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		transition: background 0.15s ease;
	}
	.btn-dark {
		background: var(--color-ink);
		color: #fff;
	}
	.btn-dark:hover {
		background: #2a2b2e;
	}
	.btn-light {
		background: #fff;
		color: var(--color-ink);
	}
	.btn-light:hover {
		background: #d9dadd;
	}

	/* Bottom CTA band */
	.cta-band {
		background: var(--color-ink);
		color: #c7c9cc;
		text-align: center;
		padding: 6rem 0;
	}
	.cta-band h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		color: #fff;
		margin-bottom: 1rem;
		max-width: 40rem;
		margin-left: auto;
		margin-right: auto;
	}
	.cta-lede {
		max-width: 34rem;
		margin: 0 auto 2rem;
		font-size: 1.1rem;
	}
	.form-success {
		margin: 1.25rem 0 0;
		padding: 0.9rem 1.1rem;
		background: #fff;
		border: 1px solid var(--color-ink);
		border-radius: 8px;
		font-weight: 500;
		color: var(--color-ink);
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
	@media (max-width: 720px) {
		.contact-body,
		.page-header,
		.cta-band {
			padding: 3.5rem 0;
		}
		.cta-band h2 {
			font-size: 1.85rem;
		}
		.cta-lede {
			font-size: 1.05rem;
		}
		.container {
			padding: 0 1.25rem;
		}
		.page-header h1 {
			font-size: 2.25rem;
		}
		.lede {
			font-size: 1.05rem;
		}
		.contact-grid {
			gap: 2.5rem;
		}
		.contact-info > p {
			margin-bottom: 1.75rem;
		}
		.info-item a {
			display: inline-block;
			padding: 0.5rem 0;
		}
		.contact-form {
			padding: 1.5rem;
		}
		/* 16px inputs keep iOS Safari from zooming in on focus. */
		.contact-form :global(.hs-input) {
			font-size: 1rem;
			padding: 0.8rem 0.9rem;
		}
		/* Full width needs border-box, or the padding overflows the viewport. */
		.contact-form :global(.hs-button) {
			display: block;
			width: 100%;
			text-align: center;
		}
		/* HubSpot lays some fields out in halves; stack them on narrow screens. */
		.contact-form :global(.hs-form-field.hs-fieldtype-text),
		.contact-form :global(.hs-form .form-columns-2 .hs-form-field) {
			width: 100%;
			float: none;
		}
		.btn {
			display: block;
			width: 100%;
			text-align: center;
		}
		/* Clear the sticky quote bar so the CTA isn't hidden behind it. */
		.cta-band {
			padding-bottom: 7rem;
		}
	}
	@media (max-width: 420px) {
		.page-header h1 {
			font-size: 2rem;
		}
	}
</style>
