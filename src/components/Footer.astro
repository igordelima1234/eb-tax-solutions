---
import {
	SITE_TITLE,
	CONTACT_PHONE,
	CONTACT_PHONE_HREF,
	CONTACT_EMAIL,
	CONTACT_HOURS,
} from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="brand">
			<img
				class="footer-logo"
				src="/images/logo-white.png"
				alt={SITE_TITLE}
				width="456"
				height="202"
			/>
			<p class="tagline">
				Enjoy expert tax services in all 50 US states, personalized just for
				you.
			</p>
		</div>
		<div class="col">
			<p class="col-title">Quick links</p>
			<a href="/about">About Us</a>
			<a href="/#services">Services</a>
			<a href="/#resources">Resources</a>
			<a href="/contact">Contact</a>
		</div>
		<div class="col">
			<p class="col-title">Contact</p>
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			<a href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a>
			<p class="note">{CONTACT_HOURS}</p>
		</div>
	</div>
	<div class="legal">
		&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
	</div>
</footer>
<style>
	footer {
		background: var(--color-ink);
		color: #b9bbbf;
		padding: 4rem 1.5rem 2rem;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2.5rem;
		max-width: 72rem;
		margin: 0 auto;
	}
	.footer-logo {
		display: block;
		height: 3.25rem;
		width: auto;
		border-radius: 0;
		margin: 0 0 1rem;
	}
	.tagline {
		font-size: 0.95rem;
		max-width: 26rem;
		margin: 0;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.col-title {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #fff;
		margin: 0 0 0.25rem;
	}
	.col a {
		color: #b9bbbf;
		font-size: 0.95rem;
		text-decoration: none;
	}
	.col a:hover {
		color: #fff;
	}
	.note {
		font-size: 0.95rem;
		margin: 0;
	}
	.legal {
		max-width: 72rem;
		margin: 3rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		footer {
			padding: 3rem 1.25rem 2rem;
		}
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.tagline {
			max-width: none;
		}
		/* Roomier rows so footer links are comfortable tap targets. */
		.col {
			gap: 0;
		}
		.col a {
			padding: 0.6rem 0;
		}
		.note {
			padding-top: 0.6rem;
		}
		.legal {
			margin-top: 2rem;
		}
	}
</style>
